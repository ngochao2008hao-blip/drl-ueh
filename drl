        // --- INTELLIGENT TEXT ANALYZER ---
        function analyzeActivityText() {
            const text = document.getElementById('activity-text').value.trim();
            if (!text) {
                alert("Vui lòng dán nội dung bài viết/thông báo hoạt động vào ô văn bản!");
                return;
            }

            const lower = text.toLowerCase();
            let detectedCode = "";
            let categoryName = "";
            let isGreen = false;
            let level = "Cấp Khoa/Đoàn-Hội/CLB";
            let targetGroup = "Sinh viên UEH";

            // Keyword detection logic
            if (lower.includes("rác") || lower.includes("dọn dẹp") || lower.includes("trồng cây") || lower.includes("green day") || lower.includes("môi trường")) {
                detectedCode = "4.1.2.G";
                categoryName = "Hành động Xanh vì môi trường (Dọn dẹp/Trồng cây)";
                isGreen = true;
            } else if (lower.includes("chạy bộ") || lower.includes("bơi lội") || lower.includes("thể thao") || lower.includes("marathon")) {
                detectedCode = "4.2.1.2.1.G";
                categoryName = "Sống khỏe - Hoạt động nâng cao sức khỏe thể chất";
                isGreen = true;
            } else if (lower.includes("tọa đàm") || lower.includes("workshop") || lower.includes("tinh thần") || lower.includes("sức khỏe tâm lý")) {
                detectedCode = "4.2.2.2.1.G";
                categoryName = "Sống khỏe - Hoạt động sức khỏe tinh thần";
                isGreen = true;
            } else if (lower.includes("nghiên cứu khoa học") || lower.includes("nckh") || lower.includes("bài báo")) {
                detectedCode = "2.6.1";
                categoryName = "Nghiên cứu khoa học sinh viên";
            } else if (lower.includes("cuộc thi") || lower.includes("thí sinh") || lower.includes("hackathon")) {
                detectedCode = "2.7.4.2";
                categoryName = "Thí sinh cuộc thi Học thuật/Khởi nghiệp";
            } else {
                detectedCode = "3.4.2.1";
                categoryName = "Tham dự Hoạt động phong trào / Tình nguyện / VH-VN-TT";
            }

            if (lower.includes("cấp ueh") || lower.includes("toàn trường") || lower.includes("đoàn - hội ueh")) {
                level = "Cấp Toàn UEH";
            }

            // Match current score
            let currentScore = 0;
            let maxScore = 5.0;

            if (isGreen) {
                const item = stateGreen.find(i => i.code === detectedCode);
                if (item) { currentScore = item.current; maxScore = item.max; }
            } else {
                const item = stateDRL.find(i => i.code === detectedCode);
                if (item) { currentScore = item.current; maxScore = item.max; }
            }

            // Display Info
            document.getElementById('res-criterion').innerText = `${detectedCode} - ${categoryName}`;
            document.getElementById('res-level').innerText = level;
            document.getElementById('res-target').innerText = targetGroup;
            document.getElementById('res-max').innerText = maxScore;
            document.getElementById('res-current').innerText = currentScore;

            // Decision Logic
            const adviceBox = document.getElementById('res-advice-box');
            const titleEl = document.getElementById('res-advice-title');
            const textEl = document.getElementById('res-advice-text');
            const tagEl = document.getElementById('res-status-tag');

            if (currentScore >= maxScore && maxScore > 0) {
                adviceBox.className = "p-4 rounded-lg border bg-red-50 border-red-200 text-red-900";
                titleEl.innerText = "KHUYÊN: KHÔNG NÊN THAM GIA (HÃY DÀNH THỜI GIAN CHO MỤC KHÁC)";
                textEl.innerText = `Bạn đã FULL trần điểm ở mục này (${currentScore}/${maxScore} điểm). Nếu tham gia thêm, bạn sẽ KHÔNG ĐƯỢC CỘNG THÊM ĐIỂM RÈN LUYỆN NÀO. Hãy nhường cơ hội hoặc dành thời gian cày các mục chưa đủ điểm!`;
                tagEl.className = "px-3 py-1 rounded-full text-xs font-bold inline-block bg-red-600 text-white";
                tagEl.innerText = "MỤC NÀY ĐÃ FULL ĐIỂM";
            } else {
                adviceBox.className = "p-4 rounded-lg border bg-emerald-50 border-emerald-200 text-emerald-900";
                titleEl.innerText = "KHUYÊN: NÊN THAM GIA NGAY!";
                textEl.innerText = `Mục này bạn hiện có ${currentScore}/${maxScore} điểm (Còn thiếu ${(maxScore - currentScore).toFixed(1)} điểm để max). Đây là cơ hội tốt để bạn tích lũy thêm điểm rèn luyện tiến tới mốc 90+!`;
                tagEl.className = "px-3 py-1 rounded-full text-xs font-bold inline-block bg-emerald-600 text-white";
                tagEl.innerText = "NÊN ĐĂNG KÝ THAM GIA";
            }

            document.getElementById('analysis-result').classList.remove('hidden');
        }
    </script>
