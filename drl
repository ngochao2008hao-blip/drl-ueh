                            onchange="onScoreChange('${type}', '${item.code}', this.value)"
                            class="w-20 text-center border rounded px-1.5 py-1 text-xs font-bold focus:ring-2 ${isNegative?'focus:ring-red-400 text-red-600':'focus:ring-blue-400 text-slate-900'}">
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- SCORE UPDATING & PERSISTENCE ---
        function onScoreChange(type, code, val) {
            let numVal = parseFloat(val) || 0;
            const dataset = type === 'drl' ? stateDRL : stateGreen;
            const item = dataset.find(i => i.code === code);

            if (item) {
                // Validation bounds
                if (item.max >= 0) {
                    if (numVal > item.max) numVal = item.max;
                    if (numVal < 0) numVal = 0;
                } else {
                    // Minus points (negative limit)
                    if (numVal < item.max) numVal = item.max;
                    if (numVal > 0) numVal = 0;
                }
                item.current = numVal;
            }

            localStorage.setItem(`ueh_${type}_state`, JSON.stringify(dataset));
            updateTotals();
            renderTable(type, dataset);
        }

        function updateTotals() {
            const totalDRL = stateDRL.reduce((sum, i) => sum + (parseFloat(i.current) || 0), 0);
            const totalGreen = stateGreen.reduce((sum, i) => sum + (parseFloat(i.current) || 0), 0);

            // Cap display at 100 max according to UEH rule
            const finalDRL = Math.min(100, Math.max(0, totalDRL)).toFixed(1);
            const finalGreen = Math.min(100, Math.max(0, totalGreen)).toFixed(1);

            document.getElementById('header-drl').innerText = finalDRL;
            document.getElementById('header-green').innerText = finalGreen;
            document.getElementById('badge-drl-total').innerText = finalDRL + " pt";
            document.getElementById('badge-green-total').innerText = finalGreen + " pt";
        }

        function filterTable(type) {
            const query = document.getElementById(`search-${type}`).value.toLowerCase();
            const dataset = type === 'drl' ? stateDRL : stateGreen;
            const filtered = dataset.filter(i => i.code.toLowerCase().includes(query) || i.name.toLowerCase().includes(query));
            renderTable(type, filtered);
        }

